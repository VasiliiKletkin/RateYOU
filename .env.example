# ─── App ─────────────────────────────────────────────────────────
ENVIRONMENT=dev                  # dev | prod
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR

# ─── Telegram Bot ────────────────────────────────────────────────
BOT_TOKEN=                       # from @BotFather
BOT_USE_WEBHOOK=false            # false=long polling (dev), true=webhook (prod)
BOT_WEBHOOK_BASE_URL=            # e.g. https://example.com  (only if BOT_USE_WEBHOOK=true)
BOT_WEBHOOK_SECRET=              # random string for X-Telegram-Bot-Api-Secret-Token header

# ─── Postgres ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rateme
POSTGRES_USER=rateme
POSTGRES_PASSWORD=rateme

# ─── Redis ───────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ─── Admin (Starlette-Admin) ─────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme          # set strong password before prod
ADMIN_SECRET_KEY=                # random 32+ char string for session encryption
