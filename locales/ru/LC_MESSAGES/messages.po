#: src/presentation/bot/handlers/create_profile.py:150
#: src/presentation/bot/handlers/create_profile.py:238
#: src/presentation/bot/handlers/edit_profile.py:341
#: src/presentation/bot/handlers/settings.py:193
#: src/presentation/bot/handlers/settings.py:223
#: src/presentation/bot/handlers/settings.py:244
#: src/presentation/bot/handlers/settings.py:265
msgid "Invalid choice"
msgstr "Неверный выбор"

#: src/presentation/bot/handlers/create_profile.py:134
msgid "Who would you like to rate?"
msgstr "Кого хочешь оценивать?"

#: src/presentation/bot/handlers/create_profile.py:156
msgid "Share your location — it's used to find nearby profiles:"
msgstr "Поделись геопозицией — она нужна, чтобы находить анкеты рядом:"

#: src/presentation/bot/handlers/create_profile.py:158
#: src/presentation/bot/handlers/edit_profile.py:150
msgid "Or just type your city name."
msgstr "Или просто напиши название своего города."

#: src/presentation/bot/handlers/create_profile.py:159
#: src/presentation/bot/handlers/edit_profile.py:151
msgid "📍 Share location"
msgstr "📍 Поделиться геопозицией"

#: src/presentation/bot/handlers/create_profile.py:174
#: src/presentation/bot/handlers/create_profile.py:250
msgid "Tell something about yourself (or /skip):"
msgstr "Расскажи о себе (или /skip):"

#: src/presentation/bot/handlers/create_profile.py:195
#: src/presentation/bot/handlers/create_profile.py:257
msgid "Please share a location to continue."
msgstr "Поделись геопозицией, чтобы продолжить."

#: src/presentation/bot/handlers/create_profile.py:204
#: src/presentation/bot/handlers/edit_profile.py:308
msgid "Couldn't look that up right now — please share your location instead."
msgstr "Сейчас не удалось найти это место — пожалуйста, отправь геопозицию."

#: src/presentation/bot/handlers/create_profile.py:209
#: src/presentation/bot/handlers/edit_profile.py:313
msgid "No such place found. Check the spelling, or share your location."
msgstr "Такое место не найдено. Проверь написание или отправь геопозицию."

#: src/presentation/bot/handlers/create_profile.py:220
#: src/presentation/bot/handlers/edit_profile.py:322
msgid "Pick your city:"
msgstr "Выбери свой город:"

#: src/presentation/bot/handlers/create_profile.py:264
#: src/presentation/bot/handlers/create_profile.py:279
#, python-brace-format
msgid "Send up to {max} photos:"
msgstr "Отправь до {max} фото:"

