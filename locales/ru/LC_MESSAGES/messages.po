#: src/presentation/bot/handlers/create_profile.py:330
#, python-brace-format
msgid ""
"<b>✅ Profile created!</b>\n"
"Name: {name}\n"
"Age: {age}\n"
"Send /feed to start rating profiles."
msgstr ""
"<b>✅ Анкета создана!</b>\n"
"Имя: {name}\n"
"Возраст: {age}\n"
"Отправь /feed, чтобы начать оценивать анкеты."

#: src/presentation/bot/handlers/create_profile.py:380
msgid "Please send a photo (not text)."
msgstr "Пожалуйста, отправь фото (не текст)."

