msgid "How old are you?"
msgstr "Сколько тебе лет?"

#: src/presentation/bot/handlers/create_profile.py:103
#: src/presentation/bot/handlers/edit_profile.py:186
msgid "Please send a number."
msgstr "Пожалуйста, отправь число."

#: src/presentation/bot/handlers/create_profile.py:108
#: src/presentation/bot/handlers/edit_profile.py:192
msgid "❌ That's not a number. Try again:"
msgstr "❌ Это не число. Попробуй ещё раз:"

#: src/presentation/bot/handlers/create_profile.py:111
#: src/presentation/bot/handlers/edit_profile.py:195
msgid "❌ Age must be between 18 and 100. Try again:"
msgstr "❌ Возраст должен быть от 18 до 100. Попробуй ещё раз:"

