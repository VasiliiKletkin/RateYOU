#: src/presentation/bot/handlers/edit_profile.py:151
#: src/presentation/bot/handlers/search_location.py:65
msgid "📍 Share location"
msgstr "📍 Поделиться геопозицией"

#: src/presentation/bot/handlers/create_profile.py:175
#: src/presentation/bot/handlers/create_profile.py:251
