#: src/presentation/bot/handlers/create_profile.py:106
#: src/presentation/bot/handlers/edit_profile.py:192
msgid "❌ Age must be between 18 and 100. Try again:"
msgstr "❌ उम्र 18 से 100 के बीच होनी चाहिए। फिर से कोशिश करो:"

#: src/presentation/bot/handlers/create_profile.py:110
