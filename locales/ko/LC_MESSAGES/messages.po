msgid "Who would you like to rate?"
msgstr ""

#: src/presentation/bot/handlers/create_profile.py:153
msgid "Share your location — it's used to find nearby profiles:"
msgstr "위치를 공유해 주세요 — 근처 프로필을 찾는 데 사용해요:"

#: src/presentation/bot/handlers/create_profile.py:154
#: src/presentation/bot/handlers/edit_profile.py:148
msgid "📍 Share location"
msgstr "📍 위치 공유"

#: src/presentation/bot/handlers/create_profile.py:169
msgid "Tell something about yourself (or /skip):"
msgstr "자기소개를 해주세요 (또는 /skip):"

#: src/presentation/bot/handlers/create_profile.py:176
msgid "Please share a location to continue."
msgstr "계속하려면 위치를 공유해 주세요."

#: src/presentation/bot/handlers/create_profile.py:184
#: src/presentation/bot/handlers/create_profile.py:201
#, python-brace-format
msgid "Send up to {max} photos:"
msgstr "최대 {max}장의 사진을 보내주세요:"

#: src/presentation/bot/handlers/create_profile.py:191
msgid "Please send text or /skip."
msgstr "텍스트로 보내거나 /skip 해주세요."

#: src/presentation/bot/handlers/create_profile.py:196
#: src/presentation/bot/handlers/edit_profile.py:235
msgid "❌ Bio is too long (max 500 chars). Try again or /skip:"
msgstr "❌ 소개가 너무 길어요 (최대 500자). 다시 입력하거나 /skip:"

#: src/presentation/bot/handlers/create_profile.py:254
#, python-brace-format
msgid ""
"<b>✅ Profile created!</b>\n"
"Name: {name}\n"
"Age: {age}\n"
"Send /feed to start rating profiles."
msgstr ""
"<b>✅ 프로필이 생성되었어요!</b>\n"
"이름: {name}\n"
"나이: {age}\n"
"/feed 를 보내서 프로필 평가를 시작해 보세요."

#: src/presentation/bot/handlers/create_profile.py:299
msgid "Please send a photo (not text)."
msgstr "사진을 보내주세요 (텍스트 말고요)."

#: src/presentation/bot/handlers/edit_profile.py:60
msgid "Session lost. Use /edit again."
msgstr "세션이 끊겼어요. /edit 을 다시 사용해 주세요."

#: src/presentation/bot/handlers/edit_profile.py:76
msgid "Profile not found."
msgstr "프로필을 찾을 수 없어요."

#: src/presentation/bot/handlers/edit_profile.py:82
msgid "Location updated."
msgstr "위치를 업데이트했어요."

#: src/presentation/bot/handlers/edit_profile.py:83
msgid "Updated. Pick another field or [Done]:"
msgstr "업데이트했어요. 다른 항목을 선택하거나 [완료]를 눌러주세요:"

#: src/presentation/bot/handlers/edit_profile.py:103
msgid "No profile to edit. Use /create first."
msgstr "수정할 프로필이 없어요. 먼저 /create 를 사용해 주세요."

#: src/presentation/bot/handlers/edit_profile.py:106
msgid "Pick a field to edit:"
msgstr "수정할 항목을 선택해 주세요:"

#: src/presentation/bot/handlers/edit_profile.py:118
msgid "Saved. /feed to keep rating."
msgstr "저장했어요. 계속 평가하려면 /feed 하세요."

#: src/presentation/bot/handlers/edit_profile.py:131
msgid "Unknown field"
msgstr "알 수 없는 항목"

#: src/presentation/bot/handlers/edit_profile.py:136
msgid "Send new name:"
msgstr "새 이름을 보내주세요:"

#: src/presentation/bot/handlers/edit_profile.py:137
