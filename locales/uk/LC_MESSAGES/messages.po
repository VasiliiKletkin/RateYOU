#, python-brace-format
msgid "{name} — {price} ⭐ / {days}d"
msgstr "{name} — {price} ⭐ / {days} дн."

#: src/presentation/bot/handlers/create_profile.py:50
msgid "Nothing to cancel."
msgstr "Немає що скасовувати."

#: src/presentation/bot/handlers/create_profile.py:53
msgid "Cancelled."
msgstr "Скасовано."

#: src/presentation/bot/handlers/create_profile.py:72
#: src/presentation/bot/handlers/create_profile.py:240
msgid "You already have a profile."
msgstr "У тебе вже є анкета."

#: src/presentation/bot/handlers/create_profile.py:77
msgid ""
"Let's create your profile.\n"
"What's your name?"
msgstr ""
"Створімо твою анкету.\n"
"Як тебе звати?"

#: src/presentation/bot/handlers/create_profile.py:83
#: src/presentation/bot/handlers/edit_profile.py:166
msgid "Please send text."
msgstr "Будь ласка, надішли текст."

#: src/presentation/bot/handlers/create_profile.py:88
#: src/presentation/bot/handlers/edit_profile.py:171
msgid "❌ Name must be 1-50 non-empty characters. Try again:"
msgstr "❌ Ім'я має бути 1-50 непорожніх символів. Спробуй ще раз:"

#: src/presentation/bot/handlers/create_profile.py:92
msgid "How old are you?"
msgstr "Скільки тобі років?"

#: src/presentation/bot/handlers/create_profile.py:98
#: src/presentation/bot/handlers/edit_profile.py:183
msgid "Please send a number."
msgstr "Будь ласка, надішли число."

#: src/presentation/bot/handlers/create_profile.py:103
#: src/presentation/bot/handlers/edit_profile.py:189
msgid "❌ That's not a number. Try again:"
msgstr "❌ Це не число. Спробуй ще раз:"

#: src/presentation/bot/handlers/create_profile.py:106
#: src/presentation/bot/handlers/edit_profile.py:192
msgid "❌ Age must be between 18 and 100. Try again:"
msgstr "❌ Вік має бути від 18 до 100. Спробуй ще раз:"

#: src/presentation/bot/handlers/create_profile.py:110
#: src/presentation/bot/handlers/edit_profile.py:138
msgid "Pick gender:"
msgstr "Обери стать:"

#: src/presentation/bot/handlers/create_profile.py:123
#: src/presentation/bot/handlers/create_profile.py:147
#: src/presentation/bot/handlers/settings.py:209
#: src/presentation/bot/handlers/settings.py:241
#: src/presentation/bot/handlers/settings.py:264
#: src/presentation/bot/handlers/settings.py:285
msgid "Invalid choice"
msgstr "Невірний вибір"

#: src/presentation/bot/handlers/create_profile.py:129
msgid "Who would you like to rate?"
msgstr ""

#: src/presentation/bot/handlers/create_profile.py:153
msgid "Share your location — it's used to find nearby profiles:"
msgstr "Поділись локацією — вона використовується для пошуку анкет поруч:"

#: src/presentation/bot/handlers/create_profile.py:154
#: src/presentation/bot/handlers/edit_profile.py:148
msgid "📍 Share location"
msgstr "📍 Поділитися локацією"

#: src/presentation/bot/handlers/create_profile.py:169
msgid "Tell something about yourself (or /skip):"
msgstr "Розкажи щось про себе (або /skip):"

#: src/presentation/bot/handlers/create_profile.py:176
msgid "Please share a location to continue."
msgstr "Будь ласка, поділись локацією, щоб продовжити."

#: src/presentation/bot/handlers/create_profile.py:184
#: src/presentation/bot/handlers/create_profile.py:201
#, python-brace-format
msgid "Send up to {max} photos:"
msgstr "Надішли до {max} фото:"

#: src/presentation/bot/handlers/create_profile.py:191
msgid "Please send text or /skip."
msgstr "Будь ласка, надішли текст або /skip."

#: src/presentation/bot/handlers/create_profile.py:196
#: src/presentation/bot/handlers/edit_profile.py:235
msgid "❌ Bio is too long (max 500 chars). Try again or /skip:"
msgstr "❌ Опис задовгий (макс. 500 символів). Спробуй ще раз або /skip:"

#: src/presentation/bot/handlers/create_profile.py:254
#, python-brace-format
msgid ""
"<b>✅ Profile created!</b>\n"
"Name: {name}\n"
"Age: {age}\n"
"Send /feed to start rating profiles."
msgstr ""
"<b>✅ Анкету створено!</b>\n"
"Ім'я: {name}\n"
"Вік: {age}\n"
"Надішли /feed, щоб почати оцінювати анкети."

#: src/presentation/bot/handlers/create_profile.py:299
msgid "Please send a photo (not text)."
msgstr "Будь ласка, надішли фото (не текст)."

#: src/presentation/bot/handlers/edit_profile.py:60
msgid "Session lost. Use /edit again."
msgstr "Сесію втрачено. Скористайся /edit знову."

#: src/presentation/bot/handlers/edit_profile.py:76
msgid "Profile not found."
msgstr "Анкету не знайдено."

#: src/presentation/bot/handlers/edit_profile.py:82
msgid "Location updated."
msgstr "Локацію оновлено."

#: src/presentation/bot/handlers/edit_profile.py:83
msgid "Updated. Pick another field or [Done]:"
msgstr "Оновлено. Обери інше поле або [Готово]:"

#: src/presentation/bot/handlers/edit_profile.py:103
msgid "No profile to edit. Use /create first."
msgstr "Немає анкети для редагування. Спочатку скористайся /create."

#: src/presentation/bot/handlers/edit_profile.py:106
msgid "Pick a field to edit:"
msgstr "Обери поле для редагування:"

#: src/presentation/bot/handlers/edit_profile.py:118
msgid "Saved. /feed to keep rating."
msgstr "Збережено. /feed, щоб продовжити оцінювання."

#: src/presentation/bot/handlers/edit_profile.py:131
msgid "Unknown field"
msgstr "Невідоме поле"

#: src/presentation/bot/handlers/edit_profile.py:136
msgid "Send new name:"
msgstr "Надішли нове ім'я:"

#: src/presentation/bot/handlers/edit_profile.py:137
msgid "Send new age (18-100):"
msgstr "Надішли новий вік (18-100):"

#: src/presentation/bot/handlers/edit_profile.py:139
msgid "Share your new location:"
msgstr "Поділись новою локацією:"

#: src/presentation/bot/handlers/edit_profile.py:140
msgid "Send new bio (or /skip to clear):"
msgstr "Надішли новий опис (або /skip, щоб очистити):"

#: src/presentation/bot/handlers/edit_profile.py:141
#, python-brace-format
msgid "Send up to {max} new photos:"
msgstr "Надішли до {max} нових фото:"

#: src/presentation/bot/handlers/edit_profile.py:208
msgid "Invalid"
msgstr "Невірно"

#: src/presentation/bot/handlers/edit_profile.py:230
msgid "Please send text or /skip to clear."
msgstr "Будь ласка, надішли текст або /skip, щоб очистити."

#: src/presentation/bot/handlers/edit_profile.py:268
msgid "Please send a photo."
msgstr "Будь ласка, надішли фото."

#: src/presentation/bot/handlers/edit_profile.py:289
msgid "Please share a location."
msgstr "Будь ласка, поділись локацією."

#: src/presentation/bot/handlers/feed.py:55
msgid "No more profiles to rate. Come back later!"
msgstr "Більше анкет для оцінки немає. Зазирни пізніше!"

#: src/presentation/bot/handlers/feed.py:82
msgid "Rate this profile:"
msgstr "Оціни цю анкету:"

#: src/presentation/bot/handlers/feed.py:104
#, python-brace-format
msgid "⭐ Someone just rated you: {score}/10"
msgstr ""

#: src/presentation/bot/handlers/feed.py:126
msgid "You need a profile of your own first. Send /create to make one."
msgstr "Спочатку потрібна своя анкета. Надішли /create, щоб її створити."

#: src/presentation/bot/handlers/feed.py:147
#: src/presentation/bot/handlers/feed.py:153
msgid "Bad payload"
msgstr "Невірні дані"

#: src/presentation/bot/handlers/feed.py:170
msgid "Can't rate yourself"
msgstr "Не можна оцінювати себе"

#: src/presentation/bot/handlers/feed.py:173
msgid "Bad score"
msgstr "Невірна оцінка"

#: src/presentation/bot/handlers/feed.py:176
#, python-brace-format
msgid "Rated {score}/10 ✓"
msgstr "Оцінено {score}/10 ✓"

#: src/presentation/bot/handlers/feed.py:186
#, python-brace-format
msgid "📊 Their average: {avg}/10 (from {count} rating)"
msgid_plural "📊 Their average: {avg}/10 (from {count} ratings)"
msgstr[0] "📊 Середня оцінка: {avg}/10 (з {count} оцінки)"
msgstr[1] "📊 Середня оцінка: {avg}/10 (з {count} оцінок)"
msgstr[2] "📊 Середня оцінка: {avg}/10 (з {count} оцінок)"

#: src/presentation/bot/handlers/feed.py:225
msgid "Skipped"
msgstr "Пропущено"

#: src/presentation/bot/handlers/premium.py:34
#, python-brace-format
msgid "Expires in {days} day."
msgid_plural "Expires in {days} days."
msgstr[0] "Закінчується через {days} день."
msgstr[1] "Закінчується через {days} дні."
msgstr[2] "Закінчується через {days} днів."

#: src/presentation/bot/handlers/premium.py:61
#, python-brace-format
msgid ""
"<b>Your premium: {tier}</b>\n"
"{expires}\n"
"Feed shows profiles with avg rating >= {threshold}.\n"
"\n"
"Pick a tier to renew or upgrade:"
msgstr ""
"<b>Твій преміум: {tier}</b>\n"
"{expires}\n"
"У стрічці анкети з середньою оцінкою >= {threshold}.\n"
"\n"
"Обери тариф, щоб продовжити або підвищити:"

#: src/presentation/bot/handlers/premium.py:72
msgid ""
"<b>Premium</b> filters your /feed to highly rated profiles.\n"
"\n"
"Pick a tier:"
msgstr ""
"<b>Преміум</b> фільтрує /feed до високооцінених анкет.\n"
"\n"
"Обери тариф:"

#: src/presentation/bot/handlers/premium.py:106
msgid "Unknown tier"
msgstr "Невідомий тариф"

#: src/presentation/bot/handlers/premium.py:109
msgid "Invoice sent — pay in the chat"
msgstr "Рахунок надіслано — оплати в чаті"

#: src/presentation/bot/handlers/premium.py:131
msgid "Unknown payment payload."
msgstr "Невідомі дані платежу."

#: src/presentation/bot/handlers/premium.py:142
msgid "This payment is not in our records."
msgstr "Цей платіж не знайдено в наших записах."

#: src/presentation/bot/handlers/premium.py:156
msgid "✅ Payment confirmed."
msgstr "✅ Платіж підтверджено."

#: src/presentation/bot/handlers/premium.py:161
#, python-brace-format
msgid ""
"<b>✅ Premium activated!</b>\n"
"Tier: {tier}\n"
"{expires}\n"
"Now /feed shows profiles rated >= {threshold}."
msgstr ""
"<b>✅ Преміум активовано!</b>\n"
"Тариф: {tier}\n"
"{expires}\n"
"Тепер /feed показує анкети з оцінкою >= {threshold}."

