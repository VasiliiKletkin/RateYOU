msgstr "⭐ Calificación mín.: solo premium"

#: src/presentation/bot/handlers/settings.py:77
#, python-brace-format
msgid "🌐 Language: {current}"
msgstr "🌐 Idioma: {current}"

#: src/presentation/bot/handlers/settings.py:106
#: src/presentation/bot/handlers/settings.py:145
msgid "<b>Settings</b>"
msgstr "<b>Ajustes</b>"

#: src/presentation/bot/handlers/settings.py:139
