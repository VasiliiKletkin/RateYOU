msgstr "No hay perfil para editar. Usa /create primero."

#: src/presentation/bot/handlers/settings.py:176
#: src/presentation/bot/handlers/settings.py:253
msgid "Premium only"
msgstr "Solo premium"

#: src/presentation/bot/handlers/settings.py:218
#: src/presentation/bot/handlers/settings.py:264
#: src/presentation/bot/handlers/settings.py:301
msgid "Updated"
msgstr "Guardado"

#: src/presentation/bot/handlers/start.py:34
msgid ""
"<b>Welcome to RateYou!</b>\n"
"You don't have a profile yet - send /create to make one."
msgstr ""
"<b>¡Bienvenido a RateYou!</b>\n"
"Aún no tienes un perfil — envía /create para crear uno."

#: src/presentation/bot/handlers/start.py:40
#, python-brace-format
msgid ""
"<b>Welcome back, {name}!</b>\n"
"Send /feed to rate other profiles."
msgstr ""
"<b>¡Bienvenido de nuevo, {name}!</b>\n"
"Envía /feed para calificar otros perfiles."

