msgid "Saved. /feed to keep rating."
msgstr "Guardado. /feed para seguir calificando."

#: src/presentation/bot/handlers/edit_profile.py:131
msgid "Unknown field"
msgstr "Campo desconocido"

#: src/presentation/bot/handlers/edit_profile.py:136
msgid "Send new name:"
msgstr "Envía el nuevo nombre:"

#: src/presentation/bot/handlers/edit_profile.py:137
msgid "Send new age (18-100):"
msgstr "Envía la nueva edad (18-100):"

#: src/presentation/bot/handlers/edit_profile.py:139
msgid "Share your new location:"
msgstr "Comparte tu nueva ubicación:"

#: src/presentation/bot/handlers/edit_profile.py:140
msgid "Send new bio (or /skip to clear):"
msgstr "Envía la nueva bio (o /skip para borrar):"

#: src/presentation/bot/handlers/edit_profile.py:141
#, python-brace-format
msgid "Send up to {max} new photos:"
msgstr "Envía hasta {max} fotos nuevas:"

#: src/presentation/bot/handlers/edit_profile.py:208
msgid "Invalid"
msgstr "Inválido"

#: src/presentation/bot/handlers/edit_profile.py:230
msgid "Please send text or /skip to clear."
msgstr "Por favor envía texto o /skip para borrar."

#: src/presentation/bot/handlers/edit_profile.py:268
msgid "Please send a photo."
msgstr "Por favor envía una foto."

#: src/presentation/bot/handlers/edit_profile.py:289
msgid "Please share a location."
msgstr "Por favor comparte una ubicación."

#: src/presentation/bot/handlers/feed.py:55
msgid "No more profiles to rate. Come back later!"
msgstr "No hay más perfiles para calificar. ¡Vuelve más tarde!"

#: src/presentation/bot/handlers/feed.py:82
msgid "Rate this profile:"
msgstr "Califica este perfil:"

#: src/presentation/bot/handlers/feed.py:104
#, python-brace-format
msgid "⭐ Someone just rated you: {score}/10"
msgstr "⭐ Alguien te acaba de calificar: {score}/10"

#: src/presentation/bot/handlers/feed.py:126
msgid "You need a profile of your own first. Send /create to make one."
msgstr "Primero necesitas tener tu propio perfil. Envía /create para crear uno."

#: src/presentation/bot/handlers/feed.py:147
#: src/presentation/bot/handlers/feed.py:153
msgid "Bad payload"
msgstr "Datos inválidos"

#: src/presentation/bot/handlers/feed.py:170
msgid "Can't rate yourself"
msgstr "No puedes calificarte a ti mismo"

#: src/presentation/bot/handlers/feed.py:173
msgid "Bad score"
msgstr "Puntuación inválida"

#: src/presentation/bot/handlers/feed.py:176
#, python-brace-format
msgid "Rated {score}/10 ✓"
msgstr "Calificado {score}/10 ✓"

#: src/presentation/bot/handlers/feed.py:186
#, python-brace-format
msgid "📊 Their average: {avg}/10 (from {count} rating)"
msgid_plural "📊 Their average: {avg}/10 (from {count} ratings)"
msgstr[0] "📊 Su promedio: {avg}/10 (de {count} calificación)"
msgstr[1] "📊 Su promedio: {avg}/10 (de {count} calificaciones)"

#: src/presentation/bot/handlers/feed.py:225
msgid "Skipped"
msgstr "Saltado"

#: src/presentation/bot/handlers/my_ratings.py:30
msgid ""
"🔒 This is a premium feature.\n"
"Use /premium to subscribe."
msgstr ""
"🔒 Esta es una función premium.\n"
"Usa /premium para suscribirte."

#: src/presentation/bot/handlers/my_ratings.py:37
msgid "No one has rated you yet."
msgstr "Aún no te ha calificado nadie."

#: src/presentation/bot/handlers/my_ratings.py:40
msgid "🌟 Latest people who rated you:"
msgstr "🌟 Quienes te calificaron recientemente:"

#: src/presentation/bot/handlers/my_ratings.py:42
msgid "Anonymous"
msgstr "Anónimo"

#: src/presentation/bot/handlers/premium.py:34
#, python-brace-format
msgid "Expires in {days} day."
msgid_plural "Expires in {days} days."
msgstr[0] "Caduca en {days} día."
msgstr[1] "Caduca en {days} días."

#: src/presentation/bot/handlers/premium.py:61
#, python-brace-format
msgid ""
"<b>Your premium: {tier}</b>\n"
"{expires}\n"
"Set your minimum rating filter via /settings.\n"
"\n"
"Pick a tier to renew or upgrade:"
msgstr ""
"<b>Tu premium: {tier}</b>\n"
"{expires}\n"
"Configura el filtro de calificación mínima en /settings.\n"
"\n"
"Elige un nivel para renovar o mejorar:"

#: src/presentation/bot/handlers/premium.py:71
msgid ""
"<b>Premium</b> unlocks the minimum-rating filter in /settings.\n"
"\n"
"Pick a tier:"
msgstr ""
"<b>Premium</b> desbloquea el filtro de calificación mínima en /settings.\n"
"\n"
"Elige un nivel:"

#: src/presentation/bot/handlers/premium.py:111
msgid "Unknown tier"
msgstr "Nivel desconocido"

#: src/presentation/bot/handlers/premium.py:114
msgid "Invoice sent — pay in the chat"
msgstr "Factura enviada — paga en el chat"

#: src/presentation/bot/handlers/premium.py:136
msgid "Unknown payment payload."
msgstr "Datos de pago desconocidos."

#: src/presentation/bot/handlers/premium.py:147
msgid "This payment is not in our records."
msgstr "Este pago no está en nuestros registros."

#: src/presentation/bot/handlers/premium.py:161
msgid "✅ Payment confirmed."
msgstr "✅ Pago confirmado."

#: src/presentation/bot/handlers/premium.py:166
#, python-brace-format
msgid ""
"<b>✅ Premium activated!</b>\n"
"Tier: {tier}\n"
"{expires}\n"
"Pick your minimum rating filter in /settings."
msgstr ""
"<b>✅ ¡Premium activado!</b>\n"
"Nivel: {tier}\n"
"{expires}\n"
"Elige tu filtro de calificación mínima en /settings."

#: src/presentation/bot/handlers/settings.py:68
#, python-brace-format
msgid "👤 Show me: {current}"
msgstr "👤 Mostrar: {current}"

#: src/presentation/bot/handlers/settings.py:72
#, python-brace-format
msgid "⭐ Min rating: {current}"
msgstr "⭐ Calificación mín.: {current}"

#: src/presentation/bot/handlers/settings.py:76
