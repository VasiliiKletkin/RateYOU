#, python-brace-format
msgid ""
"<b>✅ Profile created!</b>\n"
"Name: {name}\n"
"Age: {age}\n"
"Send /feed to start rating profiles."
msgstr ""
"<b>✅ Profil yaratildi!</b>\n"
"Ism: {name}\n"
"Yosh: {age}\n"
"Profillarni baholashni boshlash uchun /feed yubor."

