#: src/presentation/bot/handlers/create_profile.py:43
msgid "Nothing to cancel."
msgstr "Tidak ada yang dibatalkan."

#: src/presentation/bot/handlers/create_profile.py:46
msgid "Cancelled."
msgstr "Dibatalkan."

#: src/presentation/bot/handlers/create_profile.py:62
#: src/presentation/bot/handlers/create_profile.py:194
msgid "You already have a profile."
msgstr "Kamu sudah punya profil."

#: src/presentation/bot/handlers/create_profile.py:67
msgid ""
"Let's create your profile.\n"
"What's your name?"
msgstr ""
"Yuk buat profilmu.\n"
"Siapa namamu?"

#: src/presentation/bot/handlers/create_profile.py:73
#: src/presentation/bot/handlers/edit_profile.py:162
msgid "Please send text."
msgstr "Silakan kirim teks."

#: src/presentation/bot/handlers/create_profile.py:78
#: src/presentation/bot/handlers/edit_profile.py:167
msgid "❌ Name must be 1-50 non-empty characters. Try again:"
msgstr "❌ Nama harus 1-50 karakter dan tidak boleh kosong. Coba lagi:"

#: src/presentation/bot/handlers/create_profile.py:82
msgid "How old are you?"
msgstr "Berapa usiamu?"

#: src/presentation/bot/handlers/create_profile.py:88
#: src/presentation/bot/handlers/edit_profile.py:179
msgid "Please send a number."
msgstr "Silakan kirim angka."

#: src/presentation/bot/handlers/create_profile.py:93
#: src/presentation/bot/handlers/edit_profile.py:185
msgid "❌ That's not a number. Try again:"
msgstr "❌ Itu bukan angka. Coba lagi:"

#: src/presentation/bot/handlers/create_profile.py:96
#: src/presentation/bot/handlers/edit_profile.py:188
msgid "❌ Age must be between 18 and 100. Try again:"
msgstr "❌ Usia harus antara 18 dan 100. Coba lagi:"

#: src/presentation/bot/handlers/create_profile.py:100
#: src/presentation/bot/handlers/edit_profile.py:134
msgid "Pick gender:"
msgstr "Pilih jenis kelamin:"

#: src/presentation/bot/handlers/create_profile.py:113
msgid "Invalid choice"
msgstr "Pilihan tidak valid"

#: src/presentation/bot/handlers/create_profile.py:119
msgid "Share your location — it's used to find nearby profiles:"
msgstr "Bagikan lokasimu — digunakan untuk mencari profil terdekat:"

#: src/presentation/bot/handlers/create_profile.py:120
#: src/presentation/bot/handlers/edit_profile.py:144
msgid "📍 Share location"
msgstr "📍 Bagikan lokasi"

#: src/presentation/bot/handlers/create_profile.py:135
msgid "Tell something about yourself (or /skip):"
msgstr "Ceritakan sesuatu tentang dirimu (atau /skip):"

#: src/presentation/bot/handlers/create_profile.py:142
msgid "Please share a location to continue."
msgstr "Silakan bagikan lokasi untuk melanjutkan."

#: src/presentation/bot/handlers/create_profile.py:150
#: src/presentation/bot/handlers/create_profile.py:167
#, python-brace-format
msgid "Send up to {max} photos:"
msgstr "Kirim hingga {max} foto:"

#: src/presentation/bot/handlers/create_profile.py:157
msgid "Please send text or /skip."
msgstr "Silakan kirim teks atau /skip."

#: src/presentation/bot/handlers/create_profile.py:162
#: src/presentation/bot/handlers/edit_profile.py:231
msgid "❌ Bio is too long (max 500 chars). Try again or /skip:"
msgstr "❌ Bio terlalu panjang (maks 500 karakter). Coba lagi atau /skip:"

#: src/presentation/bot/handlers/create_profile.py:201
#, python-brace-format
msgid ""
"<b>✅ Profile created!</b>\n"
"Name: {name}\n"
"Age: {age}\n"
"Send /feed to start rating profiles."
msgstr ""
"<b>✅ Profil dibuat!</b>\n"
"Nama: {name}\n"
"Usia: {age}\n"
"Kirim /feed untuk mulai menilai profil."

#: src/presentation/bot/handlers/create_profile.py:238
msgid "Please send a photo (not text)."
msgstr "Silakan kirim foto (bukan teks)."

#: src/presentation/bot/handlers/edit_profile.py:59
msgid "Session lost. Use /edit again."
msgstr "Sesi hilang. Gunakan /edit lagi."

#: src/presentation/bot/handlers/edit_profile.py:75
msgid "Profile not found."
msgstr "Profil tidak ditemukan."

#: src/presentation/bot/handlers/edit_profile.py:81
msgid "Location updated."
msgstr "Lokasi diperbarui."

#: src/presentation/bot/handlers/edit_profile.py:82
msgid "Updated. Pick another field or [Done]:"
msgstr "Diperbarui. Pilih bidang lain atau [Selesai]:"

#: src/presentation/bot/handlers/edit_profile.py:99
msgid "No profile to edit. Use /create first."
msgstr "Tidak ada profil untuk diedit. Gunakan /create dulu."

#: src/presentation/bot/handlers/edit_profile.py:102
msgid "Pick a field to edit:"
msgstr "Pilih bidang untuk diedit:"

#: src/presentation/bot/handlers/edit_profile.py:114
msgid "Saved. /feed to keep rating."
msgstr "Disimpan. /feed untuk lanjut menilai."

#: src/presentation/bot/handlers/edit_profile.py:127
msgid "Unknown field"
msgstr "Bidang tidak dikenal"

#: src/presentation/bot/handlers/edit_profile.py:132
msgid "Send new name:"
msgstr "Kirim nama baru:"

#: src/presentation/bot/handlers/edit_profile.py:133
msgid "Send new age (18-100):"
msgstr "Kirim usia baru (18-100):"

#: src/presentation/bot/handlers/edit_profile.py:135
msgid "Share your new location:"
msgstr "Bagikan lokasi barumu:"

#: src/presentation/bot/handlers/edit_profile.py:136
msgid "Send new bio (or /skip to clear):"
msgstr "Kirim bio baru (atau /skip untuk menghapus):"

#: src/presentation/bot/handlers/edit_profile.py:137
#, python-brace-format
msgid "Send up to {max} new photos:"
msgstr "Kirim hingga {max} foto baru:"

#: src/presentation/bot/handlers/edit_profile.py:204
msgid "Invalid"
msgstr "Tidak valid"

#: src/presentation/bot/handlers/edit_profile.py:226
msgid "Please send text or /skip to clear."
msgstr "Silakan kirim teks atau /skip untuk menghapus."

#: src/presentation/bot/handlers/edit_profile.py:264
msgid "Please send a photo."
msgstr "Silakan kirim foto."

#: src/presentation/bot/handlers/edit_profile.py:285
msgid "Please share a location."
msgstr "Silakan bagikan lokasi."

#: src/presentation/bot/handlers/feed.py:55
msgid "No more profiles to rate. Come back later!"
msgstr "Tidak ada profil lagi untuk dinilai. Kembali lagi nanti!"

#: src/presentation/bot/handlers/feed.py:82
msgid "Rate this profile:"
msgstr "Nilai profil ini:"

#: src/presentation/bot/handlers/feed.py:104
#, python-brace-format
msgid "⭐ Someone just rated you: {score}/10"
msgstr ""

#: src/presentation/bot/handlers/feed.py:123
msgid "You need a profile of your own first. Send /create to make one."
msgstr "Kamu butuh profilmu sendiri dulu. Kirim /create untuk membuatnya."

#: src/presentation/bot/handlers/feed.py:144
#: src/presentation/bot/handlers/feed.py:150
msgid "Bad payload"
msgstr "Data tidak valid"

#: src/presentation/bot/handlers/feed.py:164
msgid "Can't rate yourself"
msgstr "Tidak bisa menilai diri sendiri"

#: src/presentation/bot/handlers/feed.py:167
msgid "Bad score"
msgstr "Nilai tidak valid"

#: src/presentation/bot/handlers/feed.py:170
#, python-brace-format
msgid "Rated {score}/10 ✓"
msgstr "Dinilai {score}/10 ✓"

#: src/presentation/bot/handlers/feed.py:180
#, python-brace-format
msgid "📊 Their average: {avg}/10 (from {count} rating)"
msgid_plural "📊 Their average: {avg}/10 (from {count} ratings)"
msgstr[0] "📊 Rata-rata mereka: {avg}/10 (dari {count} penilaian)"
msgstr[1] "📊 Rata-rata mereka: {avg}/10 (dari {count} penilaian)"

#: src/presentation/bot/handlers/feed.py:216
msgid "Skipped"
msgstr "Dilewati"

#: src/presentation/bot/handlers/premium.py:33
#, python-brace-format
msgid "Expires in {days} day."
msgid_plural "Expires in {days} days."
msgstr[0] "Berakhir dalam {days} hari."
msgstr[1] "Berakhir dalam {days} hari."

#: src/presentation/bot/handlers/premium.py:57
#, python-brace-format
msgid ""
"<b>Your premium: {tier}</b>\n"
"{expires}\n"
"Feed shows profiles with avg rating >= {threshold}.\n"
"\n"
"Pick a tier to renew or upgrade:"
msgstr ""
"<b>Premium kamu: {tier}</b>\n"
"{expires}\n"
"Feed menampilkan profil dengan rata-rata nilai >= {threshold}.\n"
"\n"
"Pilih tingkat untuk memperpanjang atau upgrade:"

#: src/presentation/bot/handlers/premium.py:68
msgid ""
"<b>Premium</b> filters your /feed to highly rated profiles.\n"
"\n"
"Pick a tier:"
msgstr ""
"<b>Premium</b> memfilter /feed kamu ke profil dengan nilai tinggi.\n"
"\n"
"Pilih tingkat:"

#: src/presentation/bot/handlers/premium.py:99
msgid "Unknown tier"
msgstr "Tingkat tidak dikenal"

#: src/presentation/bot/handlers/premium.py:102
msgid "Invoice sent — pay in the chat"
msgstr "Faktur terkirim — bayar di chat"

#: src/presentation/bot/handlers/premium.py:124
msgid "Unknown payment payload."
msgstr "Data pembayaran tidak dikenal."

#: src/presentation/bot/handlers/premium.py:135
msgid "This payment is not in our records."
msgstr "Pembayaran ini tidak ada di catatan kami."

#: src/presentation/bot/handlers/premium.py:146
msgid "✅ Payment confirmed."
msgstr "✅ Pembayaran dikonfirmasi."

#: src/presentation/bot/handlers/premium.py:151
#, python-brace-format
msgid ""
"<b>✅ Premium activated!</b>\n"
"Tier: {tier}\n"
"{expires}\n"
"Now /feed shows profiles rated >= {threshold}."
msgstr ""
"<b>✅ Premium aktif!</b>\n"
"Tingkat: {tier}\n"
"{expires}\n"
"Sekarang /feed menampilkan profil dengan nilai >= {threshold}."

#: src/presentation/bot/handlers/start.py:30
msgid ""
"<b>Welcome to RateYou!</b>\n"
"You don't have a profile yet - send /create to make one."
msgstr ""
"<b>Selamat datang di RateYou!</b>\n"
"Kamu belum punya profil - kirim /create untuk membuatnya."

#: src/presentation/bot/handlers/start.py:36
#, python-brace-format
msgid ""
"<b>Welcome back, {name}!</b>\n"
"Send /feed to rate other profiles."
msgstr ""
"<b>Selamat datang kembali, {name}!</b>\n"
"Kirim /feed untuk menilai profil lain."

