#: src/presentation/bot/handlers/create_profile.py:254
#, python-brace-format
msgid ""
"<b>✅ Profile created!</b>\n"
"Name: {name}\n"
"Age: {age}\n"
"Send /feed to start rating profiles."
msgstr ""
"<b>✅ Profil dibuat!</b>\n"
"Nama: {name}\n"
"Usia: {age}\n"
"Kirim /feed untuk mulai menilai profil."

